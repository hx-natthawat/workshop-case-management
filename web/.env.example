# Postgres (docker compose up -d)
DATABASE_URL=postgres://casemgmt:casemgmt@localhost:54329/casemgmt
# Secret for staff session cookies and signed file URLs. Change it.
APP_SECRET=change-me-to-a-long-random-string
# Public base URL of this app (used for LIFF/register links and signed file URLs)
APP_BASE_URL=http://localhost:3000
# LINE simulator for user testing. Set to false in production.
SIMULATOR_ENABLED=true

# Real LINE OA (optional). Leave empty to use the simulator only.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel ID that owns the LIFF app (used to verify ID tokens)
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
